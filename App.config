<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- HTTP debug /health и /simulate. Не 15000 (FisCat) и не 15001 (FMSKHttpService).
         Только localhost: /simulate ходит в 1С без авторизации. -->
    <add key="ListenPrefix" value="http://127.0.0.1:15002/" />
    <add key="LaneId" value="SCO01" />
    <add key="StoreId" value="" />
    <add key="CurrencyCode" value="EUR" />
    <add key="Languages" value="sk,en" />
    <add key="LogDirectory" value="logs" />
    <!-- true: ответы 1С без сети и оплата принимается локально (только стенд).
         false: товары из 1С, оплата отклоняется до интеграции с BAF. -->
    <add key="UseErpMock" value="true" />
    <add key="ErpBaseUrl" value="http://127.0.0.1/sco/hs" />
    <add key="ErpTimeoutSeconds" value="15" />
    <add key="ErpPaymentTimeoutSeconds" value="120" />
    <!-- None | Os (учётка процесса; у службы LocalSystem это учётка компьютера) | Basic (ErpUserName/ErpPassword) -->
    <add key="ErpAuth" value="Os" />
    <add key="ErpUserName" value="" />
    <add key="ErpPassword" value="" />
    <!-- Адаптер — TCP-клиент: VSS должен слушать эти порты. При обрыве или если VSS ещё не запущен
         адаптер переподключается каждые VssReconnectSeconds. -->
    <add key="EnableVss" value="false" />
    <add key="VssReconnectSeconds" value="5" />
    <add key="VssMainHost" value="127.0.0.1" />
    <add key="VssMainPort" value="17002" />
    <add key="VssCancelHost" value="127.0.0.1" />
    <add key="VssCancelPort" value="17003" />
    <add key="VssPosEventsHost" value="127.0.0.1" />
    <add key="VssPosEventsPort" value="17004" />
    <add key="VssCancelPosEventsHost" value="127.0.0.1" />
    <add key="VssCancelPosEventsPort" value="17005" />
    <!-- Канал authentication (validateUser) необязателен и в XML VSS отсутствует. -->
    <add key="VssAuthEnabled" value="false" />
    <add key="VssAuthHost" value="127.0.0.1" />
    <add key="VssAuthPort" value="17006" />
    <!-- Кастомні екрани пакетів (posEvents): layoutId BagQuantity / ChooseBag. -->
    <add key="BagPromptEnabled" value="true" />
    <add key="BagQuantityMessage" value="How many bags do you need?" />
    <add key="BagChooseMessage" value="Choose a bag" />
    <add key="Bag1Code" value="" />
    <add key="Bag1Label" value="Small bag" />
    <add key="Bag2Code" value="" />
    <add key="Bag2Label" value="Medium bag" />
    <add key="Bag3Code" value="" />
    <add key="Bag3Label" value="Large bag" />
    <add key="Bag4Code" value="" />
    <add key="Bag4Label" value="Paper bag" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
